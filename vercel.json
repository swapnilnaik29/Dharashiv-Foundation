{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/feed", "dest": "/feed.html" },
    { "src": "/discover", "dest": "/discover.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/connections", "dest": "/connections.html" },
    { "src": "/messages", "dest": "/messages.html" },
    { "src": "/jobs", "dest": "/jobs.html" },
    { "src": "/job-details", "dest": "/job-details.html" },
    { "src": "/applications", "dest": "/applications.html" },
    { "src": "/events", "dest": "/events.html" },
    { "src": "/announcements", "dest": "/announcements.html" },
    { "src": "/notifications", "dest": "/notifications.html" },
    { "src": "/settings", "dest": "/settings.html" },
    { "src": "/auth-callback", "dest": "/auth-callback.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/", "dest": "/admin/index.html" },
    { "src": "/admin/members", "dest": "/admin/members.html" },
    { "src": "/admin/moderation", "dest": "/admin/moderation.html" },
    { "src": "/admin/jobs", "dest": "/admin/jobs.html" },
    { "src": "/admin/events", "dest": "/admin/events.html" },
    { "src": "/admin/announcements", "dest": "/admin/announcements.html" },
    { "src": "/admin/categories", "dest": "/admin/categories.html" },
    { "src": "/admin/settings", "dest": "/admin/settings.html" }
  ]
}
