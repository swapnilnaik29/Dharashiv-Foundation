# ==============================================================================
# Dharashiv Foundation - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
#
# SECURITY NOTICE:
# Frontend code only receives SUPABASE_URL and SUPABASE_ANON_KEY.
# All AWS secrets and SUPABASE_SERVICE_ROLE_KEY are strictly stored in
# Supabase Edge Function Secrets / server environment and NEVER exposed to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Client & Backend)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-side only (Edge Functions / Admin CLI) - NEVER expose to frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Google OAuth Credentials (Configured in Supabase Dashboard)
# ------------------------------------------------------------------------------
# Obtained from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Add these values directly in Supabase Dashboard: Authentication > Providers > Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourGoogleClientSecret

# ------------------------------------------------------------------------------
# 3. Amazon S3 Configuration (Supabase Edge Function Secrets)
# ------------------------------------------------------------------------------
# Obtained from: AWS IAM Console (Create an IAM user with minimal S3 bucket permissions)
# Set these using: supabase secrets set AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=dharashiv-foundation-storage
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ------------------------------------------------------------------------------
# 4. Local Development Server
# ------------------------------------------------------------------------------
PORT=3000
